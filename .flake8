[flake8]
max-line-length = 88
extend-ignore = E203, W503, E501
exclude = .git, __pycache__, .venv, build, dist, backend/chroma_db
per-file-ignores =
    # warnings filter must run before chromadb is imported
    backend/app.py: E402
    # sample course text deliberately keeps trailing spaces
    backend/tests/conftest.py: W291
